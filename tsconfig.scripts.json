{
  "compilerOptions": {
    "target": "ESNext",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "bun-types"],
    "typeRoots": ["./types", "./node_modules/@types", "./node_modules"]
  },
  "include": [
    "scripts/*.ts",
    "scripts/skillopt-eval/**/*.ts",
    "types/js-yaml.d.ts"
  ]
}
