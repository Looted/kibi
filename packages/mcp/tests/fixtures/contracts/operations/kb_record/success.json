      },
      "id": "REQ-contract-seeds-cover-every-operation",
      "implementedBy": [
        {
          "sourceFile": "src/contract.ts",
          "symbol": "contract"
        }
      ],
      "properties": {
        "firmness": "default",
        "origin": {
          "kind": "agent"
