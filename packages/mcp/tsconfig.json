{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "../..",
    "baseUrl": ".",
    "types": ["node"],
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "kibi-cli/prolog": ["../cli/src/public/prolog"],
      "kibi-cli/prolog/codec": ["../cli/src/prolog/codec"],
      "kibi-cli/extractors/symbols-coordinator": [
        "../cli/src/public/extractors/symbols-coordinator"
      ],
      "kibi-cli/schemas/entity": ["../cli/src/public/schemas/entity"],
      "kibi-cli/schemas/relationship": [
        "../cli/src/public/schemas/relationship"
      ],
      "kibi-cli/schemas": ["../cli/src/public/schemas"],
      "kibi-cli/search-ranking": ["../cli/src/search-ranking"],
      "kibi-cli/public/check-types": ["../cli/src/public/check-types"],
      "kibi-cli/public/branch-resolver": ["../cli/src/public/branch-resolver"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*test*", "node_modules", "dist"]
}
