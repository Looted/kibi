{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "src",
    "baseUrl": ".",
    "types": ["node"],
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "kibi-cli/prolog": ["../cli/dist/public/prolog"],
      "kibi-cli/prolog/codec": ["../cli/dist/prolog/codec"],
      "kibi-cli/operations/runtime-types": [
        "../cli/dist/public/operations/runtime-types"
      ],
      "kibi-cli/extractors/symbols-coordinator": [
        "../cli/dist/public/extractors/symbols-coordinator"
      ],
      "kibi-cli/schemas/entity": ["../cli/dist/public/schemas/entity"],
      "kibi-cli/schemas/relationship": [
        "../cli/dist/public/schemas/relationship"
      ],
      "kibi-cli/schemas": ["../cli/dist/public/schemas"],
      "kibi-cli/search-ranking": ["../cli/dist/search-ranking"],
      "kibi-cli/public/symbol-granularity": [
        "../cli/dist/public/symbol-granularity"
      ],
      "kibi-cli/schema-version": ["../cli/dist/public/schema-version"],
      "kibi-cli/public/check-types": ["../cli/dist/public/check-types"],
      "kibi-cli/public/impact-diagnostics": [
        "../cli/dist/public/impact-diagnostics"
      ],
      "kibi-cli/public/branch-resolver": ["../cli/dist/public/branch-resolver"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*test*", "node_modules", "dist"]
}
