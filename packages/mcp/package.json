{
  "name": "kibi-mcp",
  "version": "3.1.0",
  "mcpName": "io.github.Looted/kibi-mcp",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.18.0",
    "cli-table3": "^0.6.5",
    "commander": "^11.0.0",
    "fast-glob": "^3.2.12",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "kibi-runtime": "^2.4.0",
    "kibi-core": "^0.15.1",
    "zod": "^4.3.6"
  },
  "type": "module",
  "description": "Model Context Protocol server for Kibi knowledge base",
  "main": "./dist/server.js",
  "bin": {
    "kibi-mcp": "bin/kibi-mcp"
  },
  "scripts": {
    "test": "bun test",
    "dev": "bun run bin/kibi-mcp",
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build && node ../../scripts/verify-package-contract.mjs kibi-mcp"
  },
  "files": ["dist", "bin"],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./dist/server.js"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "semver": "^7.7.4",
    "typescript": "^5.7.0",
    "kibi-cli": "workspace:*"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Piotr Franczyk",
  "homepage": "https://looted.github.io/kibi/",
  "repository": {
    "type": "git",
