{
  "name": "kibi-claude",
  "version": "0.1.0",
  "description": "Kibi Claude Code plugin - progressive-disclosure knowledge snippets, advisory freshness hooks, bundled skills, and the workspace-gated Kibi MCP server",
  "type": "module",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    ".claude-plugin",
    ".mcp.json",
    "bin",
    "hooks",
    "skills",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Looted/kibi.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && bun run build:hook-bundle && bun run ../../scripts/sync-agent-skills.ts --write --target claude",
    "build:hook-bundle": "bun run scripts/build-hook-bundle.ts",
    "check:hook-bundle": "bun run --cwd ../agent-core build && bun run scripts/build-hook-bundle.ts --check",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "kibi-cli": ">=1.0.0",
    "kibi-mcp": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "kibi-cli": {
      "optional": true
    },
    "kibi-mcp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "latest",
    "kibi-agent-core": "^0.0.0",
    "typescript": "^5.7.0",
    "yaml": "^2.9.0"
  }
}
