{
  "name": "kibi-cli",
  "version": "0.17.0",
  "type": "module",
  "description": "Kibi CLI for knowledge base management",
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "main": "./dist/cli.js",
  "bin": {
    "kibi": "bin/kibi"
  },
  "files": ["dist", "bin", "schema", "src/schemas", "src/public"],
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/public/skills && cp -r src/public/skills/. dist/public/skills/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./prolog": {
      "types": "./dist/public/prolog/index.d.ts",
      "default": "./dist/public/prolog/index.js"
    },
    "./prolog/codec": {
      "types": "./dist/prolog/codec.d.ts",
      "default": "./dist/prolog/codec.js"
    },
    "./operations/runtime-types": {
      "types": "./dist/public/operations/runtime-types.d.ts",
      "default": "./dist/public/operations/runtime-types.js"
    },
    "./operations/semantic-advisor/analyze-prose": {
      "types": "./dist/operations/semantic-advisor/analyze-prose.d.ts",
      "default": "./dist/operations/semantic-advisor/analyze-prose.js"
    },
    "./operations/semantic-advisor/prose-coverage-evaluator": {
      "types": "./dist/operations/semantic-advisor/prose-coverage-evaluator.d.ts",
      "default": "./dist/operations/semantic-advisor/prose-coverage-evaluator.js"
    },
    "./operations/semantic-advisor/types": {
      "types": "./dist/operations/semantic-advisor/types.d.ts",
      "default": "./dist/operations/semantic-advisor/types.js"
    },
    "./extractors/symbols-coordinator": {
      "types": "./dist/public/extractors/symbols-coordinator.d.ts",
      "default": "./dist/public/extractors/symbols-coordinator.js"
    },
    "./extractors/manifest": {
      "types": "./dist/public/extractors/manifest.d.ts",
      "default": "./dist/public/extractors/manifest.js"
    },
    "./extractors/markdown": {
      "types": "./dist/public/extractors/markdown.d.ts",
      "default": "./dist/public/extractors/markdown.js"
    },
    "./schemas/entity": {
      "types": "./dist/public/schemas/entity.d.ts",
      "default": "./dist/public/schemas/entity.js"
    },
    "./schemas/relationship": {
      "types": "./dist/public/schemas/relationship.d.ts",
      "default": "./dist/public/schemas/relationship.js"
    },
    "./utils/branch-resolver": {
      "types": "./dist/public/branch-resolver.d.ts",
      "default": "./dist/public/branch-resolver.js"
    },
    "./public/branch-resolver": {
      "types": "./dist/public/branch-resolver.d.ts",
      "default": "./dist/public/branch-resolver.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "default": "./dist/diagnostics.js"
    },
    "./search-ranking": {
      "types": "./dist/search-ranking.d.ts",
      "default": "./dist/search-ranking.js"
    },
    "./public/check-types": {
      "types": "./dist/public/check-types.d.ts",
      "default": "./dist/public/check-types.js"
    },
    "./public/impact-diagnostics": {
      "types": "./dist/public/impact-diagnostics.d.ts",
      "default": "./dist/public/impact-diagnostics.js"
    },
    "./public/symbol-granularity": {
      "types": "./dist/public/symbol-granularity.d.ts",
      "default": "./dist/public/symbol-granularity.js"
    },
    "./schema-version": {
      "types": "./dist/public/schema-version.d.ts",
      "default": "./dist/public/schema-version.js"
    },
    "./operational-artifacts": {
      "types": "./dist/public/operational-artifacts.d.ts",
      "default": "./dist/public/operational-artifacts.js"
    },
    "./skills": {
      "types": "./dist/public/skills.d.ts",
      "default": "./dist/public/skills.js"
    },
    "./operations": "./dist/public/operations/index.js",
    "./logic/ir": {
      "types": "./dist/logic/ir.d.ts",
      "default": "./dist/logic/ir.js"
    },
    "./operations/mutation/relationships": {
      "types": "./dist/operations/mutation/relationships.d.ts",
      "default": "./dist/operations/mutation/relationships.js"
    },
    "./operations/mutation/symbol-refresh": {
      "types": "./dist/operations/mutation/symbol-refresh.d.ts",
      "default": "./dist/operations/mutation/symbol-refresh.js"
    },
    "./operations/mutation/types": {
      "types": "./dist/operations/mutation/types.d.ts",
      "default": "./dist/operations/mutation/types.js"
    },
    "./operations/mutation/delete": {
      "types": "./dist/operations/mutation/delete.d.ts",
      "default": "./dist/operations/mutation/delete.js"
    },
    "./operations/mutation/upsert": {
      "types": "./dist/operations/mutation/upsert.d.ts",
      "default": "./dist/operations/mutation/upsert.js"
    },
    "./operations/mutation/validate-upsert": {
      "types": "./dist/operations/mutation/validate-upsert.d.ts",
      "default": "./dist/operations/mutation/validate-upsert.js"
    },
    "./operations/mutation/validation": {
      "types": "./dist/operations/mutation/validation.d.ts",
      "default": "./dist/operations/mutation/validation.js"
    },
    "./operations/modeling/model-requirement": {
      "types": "./dist/operations/modeling/model-requirement.d.ts",
      "default": "./dist/operations/modeling/model-requirement.js"
    },
    "./operations/modeling/suggest-predicates": {
      "types": "./dist/operations/modeling/suggest-predicates.d.ts",
      "default": "./dist/operations/modeling/suggest-predicates.js"
    },
    "./ignore-policy": {
      "types": "./dist/public/ignore-policy.d.ts",
      "import": "./dist/public/ignore-policy.js",
      "default": "./dist/public/ignore-policy.js"
    }
  },
  "types": "./dist/cli.d.ts",
  "dependencies": {
    "ajv": "^8.12.0",
    "cli-table3": "^0.6.5",
    "commander": "^11.0.0",
    "fast-glob": "^3.2.12",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "kibi-core": "^0.8.0",
    "ts-morph": "^23.0.0",
    "ignore": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "^5.7.0"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Piotr Franczyk",
  "repository": {
    "type": "git",
    "url": "https://github.com/Looted/kibi.git"
  }
}
