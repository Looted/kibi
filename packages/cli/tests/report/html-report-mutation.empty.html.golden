    </button>
  </li><li>
    <button type="button" class="proof-gate proof-gate--blocked" data-gate="implementation" data-label="Implementation" aria-pressed="false" aria-controls="requirements" aria-label="Implementation. No requirement stops here." disabled>
      <div class="proof-gate__node"><span>3</span></div>
      <div class="proof-gate__count">0</div>
