    </button>
  </li><li>
    <button type="button" class="proof-gate proof-gate--blocked" data-gate="e2e" data-label="E2E" aria-pressed="false" aria-controls="requirements" aria-label="E2E. No requirement stops here." disabled>
      <div class="proof-gate__node"><span>4</span></div>
      <div class="proof-gate__count">0</div>
      <div class="proof-gate__label">E2E</div>
      <div class="proof-gate__drop">No drop</div>
      <p>A scenario-backed end-to-end test exists</p>
    </button>
  </li><li>
    <button type="button" class="proof-gate proof-gate--blocked" data-gate="evidence" data-label="Tested" aria-pressed="false" aria-controls="requirements" aria-label="Tested. No requirement stops here." disabled>
      <div class="proof-gate__node"><span>5</span></div>
      <div class="proof-gate__count">0</div>
      <div class="proof-gate__label">Tested</div>
      <div class="proof-gate__drop">No drop</div>
