{
  "type": "object",
  "description": "Kibi-derived kibi.proof-receipt.v2 (kibi.proof-receipt.v1 entries are still read). Receipts are never caller-authored; kb_ingest_proof derives them from kibi.proof-run.v1 artifacts.",
  "required": [
    "version",
    "receipt_id",
    "test_id",
    "scope",
    "outcome",
    "code_snapshot",
    "environment_hash",
    "started_at",
    "finished_at",
    "artifact_digest",
    "contract_hash",
    "fingerprint",
    "fingerprint_components",
    "integration_id",
    "producer",
    "command_argv",
    "run_outcome",
    "proof_results"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["kibi.proof-receipt.v1", "kibi.proof-receipt.v2"]
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^PR-[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "test_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "enum": ["unit", "integration", "end_to_end"]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "errored",
        "cancelled",
        "skipped",
        "timed_out",
        "interrupted"
      ]
    },
    "code_snapshot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environment_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "finished_at": {
      "type": "string",
      "minLength": 1
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contract_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "binding_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fingerprint_components": {
      "type": "object",
      "required": [
        "contract",
        "integration",
        "command",
        "bindings",
        "producer"
      ],
      "additionalProperties": false,
      "properties": {
        "contract": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "integration": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "command": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bindings": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "producer": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "integration_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "command_argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "run_outcome": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "errored",
        "cancelled",
        "timed_out",
        "interrupted",
        "no_results"
      ]
    },
    "proof_results": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["symbol_id", "target", "outcome", "binding", "attempts"],
        "properties": {
          "symbol_id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "timed_out",
              "skipped",
              "interrupted",
              "errored"
            ]
          },
          "binding": {
            "type": "string",
            "enum": ["native_case", "aggregate_run"]
          },
          "native_id": {
            "type": "string",
            "minLength": 1
          },
          "attempts": {
            "oneOf": [
              {
                "type": "object",
                "required": ["status", "entries"],
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "complete"
                  },
                  "entries": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["outcome"],
                      "properties": {
                        "outcome": {
                          "type": "string",
                          "enum": [
                            "passed",
                            "failed",
                            "timed_out",
                            "skipped",
                            "interrupted",
                            "errored"
                          ]
                        },
                        "duration_ms": {
                          "type": "number",
                          "minimum": 0
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "unavailable"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "kind": {
      "type": "string",
      "enum": [
        "e2e",
        "example",
        "property",
        "exhaustive",
        "typecheck",
        "arithmetic",
        "smt",
        "rule",
        "state_machine",
        "regex",
        "source"
      ]
    },
    "evidence_level": {
      "type": "string",
      "enum": ["proved", "tested"]
    },
    "certificate": {
      "type": "object"
    },
    "certificate_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "certificate_rejection": {
      "type": "string",
      "minLength": 1
    },
    "claim_bindings": {
      "type": "array",
      "description": "Certificate kinds: how the certificate binds to each claim its contract names in proves, judged at ingest. derived means Kibi derived the certificate's obligation from the claim's grounding fact and the certificate satisfies it; attested means no derivation exists and the author vouches for it (never proved); rejected names why.",
      "items": {
        "type": "object",
        "required": ["claim_key", "binding"],
        "properties": {
          "claim_key": {
            "type": "string",
            "minLength": 1
          },
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "fact_id": {
            "type": "string",
            "minLength": 1
          },
          "binding": {
            "type": "string",
            "enum": ["derived", "attested", "rejected"]
          },
          "scope": {
            "type": "string",
            "enum": ["code", "source", "harness", "intent"]
          },
          "obligation": {
            "type": "object"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol_id", "target", "reason"],
        "properties": {
          "symbol_id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
