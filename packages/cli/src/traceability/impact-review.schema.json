{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kibi:impact-review:v1",
  "title": "Kibi content-bound local impact review record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "policy",
    "evaluator",
    "scope",
    "reviewer",
    "reviewedAt",
    "files"
  ],
  "properties": {
    "contractVersion": { "const": "kibi.impact-review.v1" },
    "policy": { "$ref": "#/$defs/policy" },
    "evaluator": { "$ref": "#/$defs/evaluator" },
    "scope": { "$ref": "#/$defs/scope" },
    "reviewer": { "$ref": "#/$defs/reviewer" },
    "reviewedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "fingerprint"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "fingerprint"],
      "properties": {
        "contractVersion": { "const": "kibi.impact-evaluator.v1" },
        "fingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "knowledgeFingerprint",
        "providerSetFingerprint"
      ],
      "properties": {
        "fingerprint": { "$ref": "#/$defs/sha256" },
        "knowledgeFingerprint": { "$ref": "#/$defs/sha256" },
        "providerSetFingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "const": "self-claimed-local" }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "uncoveredRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startLine",
        "startColumn",
        "endLine",
        "endColumn",
        "reason"
      ],
      "properties": {
        "startLine": { "type": "integer", "minimum": 1 },
        "startColumn": { "type": "integer", "minimum": 0 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "status",
        "language",
        "sourceFile",
        "providerId",
        "providerStamp",
        "providerFingerprint",
        "inputFingerprint",
        "resultFingerprint",
        "diagnosticCodes",
        "uncoveredRanges"
      ],
      "properties": {
        "contractVersion": { "const": "kibi.symbol-extractor.v2" },
        "status": { "enum": ["ok", "partial", "unsupported", "failed"] },
        "language": { "type": "string", "minLength": 1 },
        "sourceFile": { "type": "string", "minLength": 1 },
        "providerId": { "type": ["string", "null"] },
        "providerStamp": {},
        "providerFingerprint": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "inputFingerprint": { "$ref": "#/$defs/sha256" },
        "resultFingerprint": { "$ref": "#/$defs/sha256" },
        "diagnosticCodes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "uncoveredRanges": {
          "type": "array",
          "items": { "$ref": "#/$defs/uncoveredRange" }
        }
      }
    },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "objectId", "byteFingerprint", "kind", "analysis"],
      "properties": {
        "mode": { "enum": ["100644", "100755", "120000", "160000"] },
        "objectId": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
            { "type": "null" }
          ]
        },
        "byteFingerprint": { "$ref": "#/$defs/sha256" },
        "kind": { "enum": ["regular", "symlink", "gitlink"] },
        "contentProjection": { "const": "proof_receipts_stripped" },
        "analysis": {
          "oneOf": [{ "$ref": "#/$defs/analysis" }, { "type": "null" }]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["contentProjection"],
            "properties": {
              "contentProjection": { "const": "proof_receipts_stripped" }
            }
          },
          "then": { "properties": { "objectId": { "type": "null" } } }
        },
        {
          "if": { "not": { "required": ["contentProjection"] } },
          "then": {
            "properties": {
              "objectId": {
                "type": "string",
                "pattern": "^[0-9a-f]{40,64}$"
              }
            }
          }
        }
      ]
    },
    "partialReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "side", "limitationClass", "ranges", "rationale"],
      "properties": {
        "kind": { "const": "partial_review" },
        "side": { "enum": ["before", "after"] },
        "limitationClass": { "type": "string", "minLength": 1 },
        "ranges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/uncoveredRange" }
        },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "unsupportedReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "side", "wholeFile", "rationale"],
      "properties": {
        "kind": { "const": "unsupported_review" },
        "side": { "enum": ["before", "after"] },
        "wholeFile": { "const": true },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "updatedEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityId",
        "artifactPath",
        "beforeFingerprint",
        "afterFingerprint"
      ],
      "properties": {
        "entityId": { "type": "string", "minLength": 1 },
        "artifactPath": { "type": "string", "minLength": 1 },
        "beforeFingerprint": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "afterFingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "impactDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requirementIds", "knowledge"],
      "properties": {
        "kind": { "const": "impact" },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "knowledge": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "rationale"],
              "properties": {
                "state": { "const": "still_current" },
                "rationale": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "entities"],
              "properties": {
                "state": { "const": "updated" },
                "entities": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/updatedEntity" }
                },
                "stillCurrent": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["requirementId", "rationale"],
                    "properties": {
                      "requirementId": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "rationale": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "decision": {
      "oneOf": [
        { "$ref": "#/$defs/impactDecision" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason", "rationale"],
          "properties": {
            "kind": { "const": "no_impact" },
            "reason": { "type": "string", "minLength": 1 },
            "rationale": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "policyReason", "rationale"],
          "properties": {
            "kind": { "const": "not_applicable" },
            "policyReason": { "type": "string", "minLength": 1 },
            "rationale": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status",
        "analysisDepth",
        "disposition",
        "oldHunkRanges",
        "newHunkRanges",
        "before",
        "after",
        "analysisReviews",
        "decision"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "status": { "enum": ["A", "M", "R", "C", "T", "D"] },
        "oldPath": { "type": "string", "minLength": 1 },
        "copyFromPath": { "type": "string", "minLength": 1 },
        "analysisDepth": { "enum": ["symbol", "metadata", "file", "none"] },
        "disposition": { "enum": ["checked", "advisory", "skipped"] },
        "skipReason": {
          "enum": ["binary", "unsupported_encoding", "symlink", "submodule"]
        },
        "gitMode": { "type": "string" },
        "previousMode": { "type": "string" },
        "oldHunkRanges": {
          "type": "array",
          "items": { "$ref": "#/$defs/range" }
        },
        "newHunkRanges": {
          "type": "array",
          "items": { "$ref": "#/$defs/range" }
        },
        "before": { "oneOf": [{ "$ref": "#/$defs/side" }, { "type": "null" }] },
        "after": { "oneOf": [{ "$ref": "#/$defs/side" }, { "type": "null" }] },
        "analysisReviews": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/partialReview" },
              { "$ref": "#/$defs/unsupportedReview" }
            ]
          }
        },
        "decision": { "$ref": "#/$defs/decision" }
      },
      "anyOf": [
        { "properties": { "before": { "$ref": "#/$defs/side" } } },
        { "properties": { "after": { "$ref": "#/$defs/side" } } }
      ]
    }
  }
}
