{
  "name": "kibi-opencode",
  "version": "0.11.0",
  "description": "Kibi OpenCode plugin - thin adapter to integrate Kibi with OpenCode sessions",
  "type": "module",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./prompt": {
      "types": "./dist/prompt.d.ts",
      "import": "./dist/prompt.js",
      "default": "./dist/prompt.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.ts",
      "import": "./dist/scheduler.js",
      "default": "./dist/scheduler.js"
    },
    "./file-filter": {
      "types": "./dist/file-filter.d.ts",
      "import": "./dist/file-filter.js",
      "default": "./dist/file-filter.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Looted/kibi.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && bun run scripts/build-tui.ts && tsc -p tsconfig.tui-types.json",
    "build:tui": "bun run scripts/build-tui.ts && tsc -p tsconfig.tui-types.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.4.7",
    "@opentui/core": "^0.1.99",
    "@opentui/solid": "^0.1.99",
    "kibi-cli": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "^5.0.0"
  }
}