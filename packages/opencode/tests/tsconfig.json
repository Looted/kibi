{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "rootDir": "..",
    "types": ["bun-types"],
    "jsx": "react",
    "jsxImportSource": "",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment"
  },
  "include": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "globals.d.ts",
    "../src/**/*.d.ts"
  ]
}
