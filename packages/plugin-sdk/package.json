{
  "name": "kibi-plugin-sdk",
  "version": "0.3.0",
  "description": "Public protocol types and validators for Kibi capability plugins",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --timeout 15000 .",
    "prepack": "npm run build && node ../../scripts/verify-package-contract.mjs kibi-plugin-sdk"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Piotr Franczyk",
  "repository": {
    "type": "git",
    "url": "https://github.com/Looted/kibi.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "^5.7.0"
  }
}
