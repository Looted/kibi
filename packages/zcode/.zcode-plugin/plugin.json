{
  "name": "kibi-zcode",
  "version": "0.16.0",
  "description": "Kibi ZCode plugin manifest for integrating the Kibi MCP, bundled Kibi skills, and advisory workflow hooks into ZCode sessions.",
  "author": {
    "name": "Piotr Franczyk"
  },
  "homepage": "https://looted.github.io/kibi/",
  "repository": "https://github.com/Looted/kibi",
  "license": "AGPL-3.0-or-later",
  "keywords": ["kibi", "mcp", "requirements", "traceability", "knowledge-base"],
  "skills": "skills",
  "commands": "commands",
  "mcpServers": {
    "kibi": {
      "command": "node",
      "args": ["${ZCODE_PLUGIN_ROOT}/bin/mcp-launcher.cjs"],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "enabled": true,
      "timeoutMs": 60000
    }
  }
}
