{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/bin/hook-runner.mjs\"",
            "timeoutMs": 15000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/bin/hook-runner.mjs\"",
            "timeoutMs": 15000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Edit|MultiEdit|Write|apply_patch|Read|Grep|Bash|mcp__.*__kb_.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/bin/hook-runner.mjs\"",
            "timeoutMs": 15000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/bin/hook-runner.mjs\"",
            "timeoutMs": 15000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/bin/hook-runner.mjs\"",
            "timeoutMs": 15000
          }
        ]
      }
    ]
  }
}
