{
  "name": "kibi-zcode",
  "version": "0.1.0",
  "description": "Kibi ZCode plugin - thin adapter for ZCode MCP integration",
  "type": "module",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    ".zcode-plugin",
    "bin",
    "hooks",
    "skills",
    "commands",
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Looted/kibi.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && bun run ../../scripts/sync-agent-skills.ts --write --target zcode && bun run scripts/copy-plugin-assets.ts",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "kibi-cli": ">=1.0.0",
    "kibi-mcp": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "kibi-cli": {
      "optional": true
    },
    "kibi-mcp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "^5.7.0"
  }
}
