{
  "name": "kibi-agent-core",
  "version": "0.15.0",
  "description": "Shared low-latency hook helpers for Kibi agent adapters",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bash-command": {
      "types": "./dist/bash-command.d.ts",
      "default": "./dist/bash-command.js"
    },
    "./decision-guard": {
      "types": "./dist/decision-guard.d.ts",
      "default": "./dist/decision-guard.js"
    },
    "./hook-usage-log": {
      "types": "./dist/hook-usage-log.d.ts",
      "default": "./dist/hook-usage-log.js"
    },
    "./kb-mcp-tools": {
      "types": "./dist/kb-mcp-tools.d.ts",
      "default": "./dist/kb-mcp-tools.js"
    },
    "./knowledge-index": {
      "types": "./dist/knowledge-index.d.ts",
      "default": "./dist/knowledge-index.js"
    },
    "./path-policy": {
      "types": "./dist/path-policy.d.ts",
      "default": "./dist/path-policy.js"
    },
    "./requirement-candidates": {
      "types": "./dist/requirement-candidates.d.ts",
      "default": "./dist/requirement-candidates.js"
    },
    "./usage-telemetry": {
      "types": "./dist/usage-telemetry.d.ts",
      "default": "./dist/usage-telemetry.js"
    },
    "./snippets": {
      "types": "./dist/snippets.d.ts",
      "default": "./dist/snippets.js"
    },
    "./checkout-hooks": {
      "types": "./dist/checkout-hooks.d.ts",
      "default": "./dist/checkout-hooks.js"
    },
    "./firm-edit-review": {
      "types": "./dist/firm-edit-review.d.ts",
      "default": "./dist/firm-edit-review.js"
    },
    "./session-brief": {
      "types": "./dist/session-brief.d.ts",
      "default": "./dist/session-brief.js"
    },
    "./workspace-optin": {
      "types": "./dist/workspace-optin.d.ts",
      "default": "./dist/workspace-optin.js"
    },
    "./version-control": {
      "types": "./dist/version-control.d.ts",
      "default": "./dist/version-control.js"
    },
    "./hook-input": {
      "types": "./dist/hook-input.d.ts",
      "default": "./dist/hook-input.js"
    },
    "./retrieval": {
      "types": "./dist/retrieval.d.ts",
      "default": "./dist/retrieval.js"
    },
    "./retrieval-tokens": {
      "types": "./dist/retrieval-tokens.d.ts",
      "default": "./dist/retrieval-tokens.js"
    }
  },
  "files": ["dist", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build && node ../../scripts/verify-package-contract.mjs kibi-agent-core"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Piotr Franczyk",
  "homepage": "https://looted.github.io/kibi/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Looted/kibi.git",
    "directory": "packages/agent-core"
  },
  "bugs": {
    "url": "https://github.com/Looted/kibi/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.9.8",
    "semver": "^7.8.5",
    "typescript": "^5.7.0",
    "yaml": "^2.9.1"
  }
}
