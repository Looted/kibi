{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node bin/hook-runner.mjs"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node bin/hook-runner.mjs"
      }
    ],
    "preToolUse": [
      {
        "command": "node bin/hook-runner.mjs"
      }
    ],
    "postToolUse": [
      {
        "command": "node bin/hook-runner.mjs"
      }
    ],
    "beforeReadFile": [
      {
        "command": "node bin/hook-runner.mjs"
      }
    ],
    "stop": [
      {
        "command": "node bin/hook-runner.mjs",
        "loop_limit": 1
      }
    ]
  }
}
