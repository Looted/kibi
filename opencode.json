{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [],
  "mcp": {
    "kibi": {
      "type": "local",
      "command": [
        "sh",
        "-lc",
        "repo_root=$(git rev-parse --show-toplevel) && exec bun run \"$repo_root/packages/mcp/bin/kibi-mcp\" --diagnostic-mode"
      ],
      "enabled": true
    }
  },
  "lsp": {
    "prolog": {
      "command": [
        "swipl",
        "-g",
        "use_module(library(lsp_server)).",
        "-g",
        "lsp_server:main",
        "-t",
        "halt",
        "--",
        "stdio"
      ],
      "extensions": [".pl", ".prolog", ".plt"]
    }
  }
}
