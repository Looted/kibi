+                 findall(T, thread_property(T, status(running)), Threads),
+                 get_time(Now),
+                 setup_call_cleanup(
+                     open(File, append, Stream),
+                     format(Stream, "~w ~3f pid=~w thread=~w gen=~w threads=~w ~w ~q~n",
+                            [N, Now, Pid, Thread, Gen, Threads, Event, Detail]),
