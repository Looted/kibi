+                 Count > 1 ),
+               kb_diag(dup_after_write, entity(Id, Key, Count)))
+    ;   true
+    ).
+
+kb_diag_monitor(Event) :-
+    (   Event = transaction(BeginOrEnd, Id)
+    ->  kb_diag(transaction, BeginOrEnd-Id)
+    ;   true
+    ).
+
