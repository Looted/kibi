{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillOpt host preflight receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "targetModel",
    "optimizerModel",
    "skilloptCommit",
    "hosts",
    "verdict"
  ],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "targetModel": { "const": "gpt-5.4-mini" },
    "optimizerModel": { "const": "gpt-5.6-sol" },
    "skilloptCommit": { "const": "b860a5cf88ce75e2bd02ca981ac21fb28cffba83" },
    "hosts": { "type": "array", "items": { "type": "object" } },
    "verdict": { "enum": ["pass", "no-go"] },
    "reason": { "type": "string", "minLength": 1 },
    "paidModelCalls": { "const": 0 }
  }
}
