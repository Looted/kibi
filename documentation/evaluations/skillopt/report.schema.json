{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillOpt gate report",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "skill", "variants", "cells", "costUsd", "verdict"],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "skill": { "type": "string", "minLength": 1 },
    "variants": {
      "type": "array",
      "const": ["baseline", "one-shot", "skillopt"]
    },
    "cells": { "type": "array", "minItems": 1 },
    "costUsd": { "type": "number", "minimum": 0, "maximum": 400 },
    "verdict": { "enum": ["pass", "fail", "no-go"] }
  }
}
