{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract-definitions.schema.json",
  "$defs": {
    "schemaVersion": { "const": "1.0.0" },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576
    },
    "artifactId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:[0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "jsonValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 1048576 },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "cachedInputTokens", "outputTokens"],
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "cachedInputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 }
      }
    },
    "priceEquivalentEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "amount", "pricingHash", "kind"],
      "properties": {
        "currency": { "const": "USD" },
        "amount": { "type": "number", "minimum": 0 },
        "pricingHash": { "$ref": "#/$defs/sha256" },
        "kind": { "const": "price-equivalent-estimate-not-invoice" }
      }
    }
  }
}
