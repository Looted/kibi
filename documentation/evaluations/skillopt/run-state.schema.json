{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-state.schema.json",
  "title": "SkillOpt run state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "runId",
    "runLockHash",
    "phase",
    "completedEpisodeIds",
    "ledgerHeadHash",
    "updatedAt",
    "interrupted"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "contract-definitions.schema.json#/$defs/schemaVersion"
    },
    "artifactType": { "const": "run-state" },
    "runId": {
      "$ref": "contract-definitions.schema.json#/$defs/artifactId"
    },
    "runLockHash": { "$ref": "contract-definitions.schema.json#/$defs/sha256" },
    "phase": {
      "enum": [
        "preflight",
        "development",
        "optimization",
        "held-out",
        "bundle",
        "review",
        "complete",
        "no-go"
      ]
    },
    "completedEpisodeIds": {
      "type": "array",
      "items": {
        "$ref": "contract-definitions.schema.json#/$defs/artifactId"
      },
      "uniqueItems": true
    },
    "ledgerHeadHash": {
      "oneOf": [
        { "$ref": "contract-definitions.schema.json#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "updatedAt": {
      "$ref": "contract-definitions.schema.json#/$defs/timestamp"
    },
    "interrupted": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "phase": { "const": "complete" } },
        "required": ["phase"]
      },
      "then": { "properties": { "interrupted": { "const": false } } }
    }
  ]
}
